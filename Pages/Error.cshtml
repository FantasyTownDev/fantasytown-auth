@page
@model FantasyTown.Auth.Pages.ErrorModel
@{
    ViewData["Title"] = "出错了";
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FantasyTown Auth</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #1a1a2e; color: #e0e0e0; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .container { text-align: center; padding: 2rem; }
        h1 { color: #00d4ff; font-size: 2.5rem; margin-bottom: 1rem; }
        p { color: #a0a0a0; font-size: 1.1rem; margin-bottom: 2rem; }
        a { padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: bold; background: #00d4ff; color: #1a1a2e; display: inline-block; }
        a:hover { background: #00b8d4; }
    </style>
</head>
<body>
    <div class="container">
        <h1>出错了</h1>
        <p>服务器处理请求时发生错误，请稍后重试。如持续出现请联系管理员。</p>
        <a asp-page="/Index">返回首页</a>
    </div>
</body>
</html>
